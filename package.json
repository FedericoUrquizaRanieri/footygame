    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "Desafío diario de fútbol: conectá dos jugadores a través de clubes y compañeros.",
