{
  "name": "footygame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "tsx scripts/db/init-local.ts",
    "db:down": "docker compose --env-file .env.local down",
    "db:destroy": "docker compose --env-file .env.local down -v",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "data:extract": "python scripts/pipeline/extract.py",
    "data:load": "tsx scripts/pipeline/load.ts",
    "data:challenges": "tsx scripts/pipeline/generate-challenges.ts",
    "data:photos": "tsx scripts/pipeline/fetch-photos.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "Desafío diario de fútbol: conectá dos jugadores a través de clubes y compañeros.",
  "engines": {
    "node": ">=22"
  }
}
