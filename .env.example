# Copiar a .env.local y completar. NUNCA versionar .env.local.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: son solo del servidor (ver docs/02-architecture/security.md).

# Cadena de conexión a Postgres de Supabase (pooler, rol de solo lectura para la app)
DATABASE_URL=

# Cadena de conexión con permisos de escritura, SOLO para scripts de carga (nunca en Vercel)
DATABASE_URL_ADMIN=

# Rate limiting (si se usa un almacén externo, p. ej. Upstash)
RATE_LIMIT_REDIS_URL=
