# Copiar a .env.local y completar. NUNCA versionar .env.local.
# Ninguna de estas variables lleva prefijo público: son solo del servidor (ver docs/02-architecture/security.md).
#
# En desarrollo local NO hace falta completarlo a mano: `npm run db:up` genera .env.local con
# credenciales aleatorias para el Postgres de Docker (puerto 5433).

# Postgres de Docker: contraseñas de los roles (las usa docker-compose.yml)
POSTGRES_SUPERUSER_PASSWORD=
FOOTYGAME_ADMIN_PASSWORD=
FOOTYGAME_APP_PASSWORD=

# Conexión de la app web: rol de SOLO LECTURA (en producción: pooler de Supabase con un rol equivalente)
DATABASE_URL=

# Conexión con permisos de escritura, SOLO para scripts de migración y carga (nunca en Vercel)
DATABASE_URL_ADMIN=

# Base y roles usados por los tests de integración y seguridad
TEST_DATABASE_URL=
TEST_DATABASE_URL_ADMIN=

# Mail de contacto para pedidos de retiro de contenido (se muestra en /legal). Opcional.
CONTACT_EMAIL=
