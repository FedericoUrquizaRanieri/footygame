# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# tests y cobertura
/coverage

# variables de entorno (se versiona solo .env.example)
.env
.env.*
!.env.example

# Vercel
.vercel

# datos crudos del spike (se descargan con scripts/spike/download.py)
/data/raw/*
!/data/raw/.gitkeep
# datos generados por scripts/pipeline/extract.py (se regeneran)
/data/processed/
*.duckdb
*.duckdb.wal
*.csv.gz

# fotos de jugadores descargadas por scripts/pipeline/fetch-photos.ts (se regeneran con npm run data:photos).
# En producción se sirven desde Supabase Storage (npm run data:upload-photos).
/public/players/
/data/cache/

# Python
__pycache__/
*.pyc
.venv/

# sistema / editores
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# datos de las pruebas con amigos (nombres y respuestas personales); el repo es publico
/playtest/etiquetado_fama*
/playtest/planilla_*.md
/playtest/pool_v0.*
